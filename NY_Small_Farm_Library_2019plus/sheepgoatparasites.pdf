</div><!--/$--><!--$--><div id="i8tgaajx" class="ku3DBC zQ9jDz qvSjx3 Vq6kJx i8tgaajx wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.3em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:16px;" class="wixui-rich-text__text"><span style="text-decoration:underline;" class="wixui-rich-text__text"><span style="color:rgb(0, 0, 255);" class="wixui-rich-text__text"><a href="https://www.sheepandgoat.com/abomasal-bloat" target="_self" class="wixui-rich-text__text"><span class="color_2 wixui-rich-text__text">Abomasal bloat</span></a></span></span><br class="wixui-rich-text__text">
